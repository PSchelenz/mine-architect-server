{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": [
    "resources/**/*.ts",
    "resources/**/*.tsx",
    "resources/**/*.d.ts",
    "resources/**/*.vue", "resources/js/composables/useForm.js",
  ],
  "exclude": [
    "node_modules",
    "public"
  ],
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "baseUrl": ".",
    "jsx": "preserve",
    "paths": {
      "@/*": ["resources/js/*"],
      "@components/*": ["resources/js/views/components/*"],
      "@composables/*": ["resources/js/composables/*"],
      "@router/*": ["resources/js/router/*"],
      "@store/*": ["resources/js/store/*"],
      "@views/*": ["resources/js/views/*"],
      "@styles/*": ["resources/scss/*"]
    },
    "types": ["vite/client"],
  },
}
